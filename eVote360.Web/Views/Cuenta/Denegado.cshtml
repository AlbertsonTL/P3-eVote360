@{
    ViewData["Title"] = "Acceso Denegado";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mx-auto text-center">
            <div class="card border-danger shadow">
                <div class="card-body p-5">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-shield-x"></i>
                    </div>
                    <h2 class="text-danger mb-3">Acceso Denegado</h2>
                    <p class="lead text-muted">
                        No posee permisos para acceder a esta sección del sistema.
                    </p>
                    <hr>
                    @if (userRole == "Administrador")
                    {
                        <a href="/Admin/Home/Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door"></i> Ir al Panel de Administración
                        </a>
                    }
                    else if (userRole == "Dirigente")
                    {
                        <a href="/Dirigente/Home/Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door"></i> Ir al Panel del Dirigente
                        </a>
                    }
                    else
                    {
                        <a href="/Login/Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
