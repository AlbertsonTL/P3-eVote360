@model List<eVote360.Application.ViewModels.Users.UserVM>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    bool hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-person-badge"></i> Usuarios</h1>
            <p class="mb-0">Administre los usuarios del sistema</p>
        </div>
        <div class="d-flex gap-2">
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-person-plus-fill"></i> Nuevo Usuario
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled title="No se pueden crear usuarios durante una elección activa">
                    <i class="bi bi-lock"></i> Nueva (Elección activa)
                </button>
            }
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Menú Principal
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (hasActiveElection)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill"></i> <strong>Elección activa:</strong> No se pueden crear, editar ni cambiar el estado de usuarios mientras haya una elección en proceso.
    </div>
}

<div class="card">
    <div class="card-header"><i class="bi bi-list-ul"></i> Listado de Usuarios</div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>@item.Email</td>
                                <td><code>@item.NombreUsuario</code></td>
                                <td><span class="badge bg-info">@item.Rol</span></td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    @if (!hasActiveElection)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        if (item.IsActive)
                                        {
                                            <a asp-action="ConfirmToggle" asp-route-id="@item.Id" asp-route-activate="false" class="btn btn-sm btn-danger ms-1">
                                                <i class="bi bi-toggle-off"></i> Desactivar
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="ConfirmToggle" asp-route-id="@item.Id" asp-route-activate="true" class="btn btn-sm btn-success ms-1">
                                                <i class="bi bi-toggle-on"></i> Activar
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled><i class="bi bi-lock"></i> Bloqueado</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No hay usuarios registrados.
            </div>
        }
    </div>
</div>
