@{ ViewData["Title"] = "Cambiar Estado Candidato"; var c = ViewBag.Candidato as eVote360.Domain.Entities.Candidate.Candidate; string accion = ViewBag.Accion; }
<div class="page-header"><h1><i class="bi bi-toggle-on"></i> Cambiar Estado</h1></div>
<div class="row"><div class="col-md-6 mx-auto">
    <div class="card border-warning slide-up"><div class="card-body p-4 text-center">
        <h4>¿Desea @accion al candidato <strong>@c?.Nombre @c?.Apellido</strong>?</h4>
        <div class="d-flex gap-3 justify-content-center mt-4">
            <form asp-action="Toggle" asp-route-id="@c?.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning btn-lg"><i class="bi bi-check-circle"></i> Confirmar</button>
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg"><i class="bi bi-x-circle"></i> Cancelar</a>
        </div>
    </div></div>
</div></div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
