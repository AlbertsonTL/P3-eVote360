@model eVote360.Application.ViewModels.Party.PartyFormVM
@{
    ViewData["Title"] = "Editar Partido";
}

<div class="page-header">
    <h1><i class="bi bi-pencil-square"></i> Editar Partido</h1>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LogoPath" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <div class="text-center mb-3">
                            <img src="@Model.LogoPath" alt="Logo actual" style="max-width: 150px; max-height: 150px;">
                            <p class="text-muted small">Logo actual</p>
                        </div>
                    }
                    
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre del Partido</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Siglas" class="form-label">Siglas</label>
                        <input asp-for="Siglas" class="form-control" />
                        <span asp-validation-for="Siglas" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Logo" class="form-label">Nuevo Logo (opcional)</label>
                        <input asp-for="Logo" class="form-control" type="file" accept="image/*" />
                        <small class="text-muted">Deje en blanco para mantener el logo actual</small>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
