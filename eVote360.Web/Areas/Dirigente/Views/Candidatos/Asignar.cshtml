@using eVote360.Application.DTOs.Response
@model eVote360.Application.ViewModels.Candidates.CandidateAssignVM
@{
    ViewData["Title"] = "Asignar Candidato a Puesto";
    var candidatos = ViewBag.Candidatos as List<CandidateResponseDto> ?? new();
    var puestos = ViewBag.Puestos as List<PositionResponse> ?? new();
}

<div class="page-header">
    <h1><i class="bi bi-award-fill"></i> Asignar Candidato a Puesto</h1>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Seleccione el candidato y el puesto
            </div>
            <div class="card-body p-4">
                @if (!candidatos.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> No hay candidatos activos disponibles para asignar.
                        <a asp-action="Create" class="alert-link">Crear candidato</a>
                    </div>
                }
                else if (!puestos.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> No hay puestos electivos activos disponibles.
                    </div>
                }
                else
                {
                    <form asp-action="Asignar" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="CandidateId" class="form-label fw-bold">Candidato</label>
                            <select asp-for="CandidateId" class="form-select form-select-lg">
                                <option value="">-- Seleccione un candidato --</option>
                                @foreach (var c in candidatos)
                                {
                                    <option value="@c.Id">
                                        @c.Nombre @c.Apellido
                                        @(c.PositionId.HasValue ? $" (actualmente: {c.PositionNombre})" : " (sin puesto)")
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="CandidateId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PositionId" class="form-label fw-bold">Puesto Electivo</label>
                            <select asp-for="PositionId" class="form-select form-select-lg">
                                <option value="">-- Seleccione un puesto --</option>
                                @foreach (var p in puestos)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="PositionId" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <strong><i class="bi bi-info-circle"></i> Reglas de postulación:</strong>
                            <ul class="mb-0 mt-1">
                                <li>Un candidato solo puede aspirar a un puesto dentro del mismo partido.</li>
                                <li>Un candidato aliado puede postularse para el mismo puesto en otro partido aliado.</li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-award"></i> Asignar Puesto
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
