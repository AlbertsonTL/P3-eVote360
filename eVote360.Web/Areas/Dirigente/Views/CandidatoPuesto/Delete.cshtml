@{ ViewData["Title"] = "Quitar Asignación"; }
<div class="page-header"><h1><i class="bi bi-trash"></i> Quitar Asignación</h1></div>
<div class="row"><div class="col-md-6 mx-auto">
    <div class="card border-danger slide-up"><div class="card-body p-4 text-center">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size:3rem;"></i>
        <h4 class="mt-3">¿Desea quitar la asignación de <strong>@ViewBag.CandidaturaNombre</strong> del puesto <strong>@ViewBag.PuestoNombre</strong>?</h4>
        <div class="d-flex gap-3 justify-content-center mt-4">
            <form asp-action="Delete" asp-route-id="@ViewBag.CandidaturaId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-lg"><i class="bi bi-check-circle"></i> Confirmar</button>
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg"><i class="bi bi-x-circle"></i> Cancelar</a>
        </div>
    </div></div>
</div></div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
