@model List<eVote360.Application.ViewModels.Position.PositionListVM>
@{
    ViewData["Title"] = "Gestión de Puestos Electivos";
    var hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-briefcase-fill"></i> Puestos Electivos</h1>
            <p class="mb-0">Administre los cargos disponibles para elección</p>
        </div>
        <div>
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill"></i> Nuevo Puesto
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled title="No se pueden crear puestos durante una elección activa">
                    <i class="bi bi-lock-fill"></i> Crear (Bloqueado)
                </button>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show slide-up" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show slide-up" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (hasActiveElection)
{
    <div class="alert alert-warning slide-up">
        <i class="bi bi-exclamation-triangle-fill"></i> 
        <strong>Elección Activa:</strong> No se pueden crear, editar o cambiar el estado de puestos durante una elección.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon primary">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="stat-card-title">Total Puestos</div>
            <div class="stat-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon success">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-card-title">Activos</div>
            <div class="stat-card-value">@Model.Count(p => p.IsActive)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon danger">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="stat-card-title">Inactivos</div>
            <div class="stat-card-value">@Model.Count(p => !p.IsActive)</div>
        </div>
    </div>
</div>

<div class="card slide-up">
    <div class="card-header">
        <i class="bi bi-list-ul"></i> Listado de Puestos Electivos
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var position in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 @(position.IsActive ? "border-success" : "border-danger")">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title mb-0">
                                        <i class="bi bi-award"></i> @position.Nombre
                                    </h5>
                                    @if (position.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </div>
                                <p class="card-text text-muted">@position.Descripcion</p>
                                
                                @if (!hasActiveElection)
                                {
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="Edit" asp-route-id="@position.Id" class="btn btn-warning">
                                            <i class="bi bi-pencil-fill"></i> Editar
                                        </a>
                                        <form asp-action="Toggle" asp-route-id="@position.Id" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="@(position.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                              data-confirm-message="¿Está seguro que desea @(position.IsActive ? "desactivar" : "activar") el puesto «@(position.Nombre)»?"
                                              data-confirm-consequence="@(position.IsActive ? "Este puesto dejará de estar disponible para nuevas elecciones y asignaciones." : "Este puesto volverá a estar disponible para elecciones y asignaciones.")"
                                              data-confirm-variant="@(position.IsActive ? "danger" : "success")"
                                              data-confirm-ok="@(position.IsActive ? "Desactivar" : "Activar")">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(position.IsActive ? "btn-danger" : "btn-success")">
                                                <i class="bi bi-@(position.IsActive ? "x-circle-fill" : "check-circle-fill")"></i>
                                                @(position.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        <i class="bi bi-lock-fill"></i> Acciones Bloqueadas
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill"></i> No hay puestos electivos registrados. Cree el primero usando el botón "Nuevo Puesto".
            </div>
        }
    </div>
</div>

