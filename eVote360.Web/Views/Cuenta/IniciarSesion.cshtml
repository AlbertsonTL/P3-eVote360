@model eVote360.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card voting-card fade-in">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="stat-card-icon primary mx-auto mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-circle" style="font-size: 2.5rem;"></i>
                        </div>
                        <h2>Iniciar Sesión</h2>
                        <p class="text-muted">Acceso al sistema administrativo</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger slide-up">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                        </div>
                    }

                    <form asp-action="IniciarSesion" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Usuario" class="form-label">
                                <i class="bi bi-person-fill"></i> Usuario
                            </label>
                            <input asp-for="Usuario" class="form-control form-control-lg" placeholder="Ingrese su usuario" autofocus />
                            <span asp-validation-for="Usuario" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock-fill"></i> Contraseña
                            </label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Ingrese su contraseña" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </button>
                        
                        <div class="text-center">
                            <a asp-controller="Home" asp-action="Index" class="text-muted">
                                <i class="bi bi-arrow-left"></i> Volver al inicio
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
