@using eVote360.Domain.Entities
@model List<Candidatura>
@{ ViewData["Title"] = "Candidatos Asignados a Puestos"; }
<div class="page-header fade-in">
    <div class="d-flex justify-content-between align-items-center">
        <h1><i class="bi bi-award"></i> Candidatos Asignados a Puestos</h1>
        <div class="d-flex gap-2">
            @if (!(bool)ViewBag.HasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Asignación</a>
            }
            <a asp-area="Dirigente" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Menú Principal
            </a>
        </div>
    </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div> }
<div class="card slide-up"><div class="card-body">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center"><i class="bi bi-info-circle"></i> No hay candidatos asignados a puestos.</div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-hover align-middle">
            <thead class="table-dark"><tr><th>Candidato</th><th>Partido Origen</th><th>Puesto</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Candidate?.Nombre @c.Candidate?.Apellido</strong></td>
                        <td><span class="badge bg-info">@c.Candidate?.Party?.Siglas</span></td>
                        <td>@c.Position?.Nombre</td>
                        <td>
                            @if (!(bool)ViewBag.HasActiveElection)
                            {
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Quitar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div></div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
