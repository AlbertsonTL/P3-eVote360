@model List<eVote360.Application.ViewModels.Users.UserVM>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    bool hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-person-badge"></i> Usuarios</h1>
            <p class="mb-0">Administre los usuarios del sistema</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-person-plus-fill"></i> Nuevo Usuario
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled title="No se pueden crear usuarios durante una elección activa">
                    <i class="bi bi-lock"></i> Nuevo (Bloqueado)
                </button>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (hasActiveElection)
{
    <div class="election-lock-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div><strong>Elección activa:</strong> no se pueden crear, editar ni cambiar el estado de usuarios mientras haya una elección en proceso.</div>
    </div>
}

<div class="card">
    <div class="card-header"><i class="bi bi-list-ul"></i> Listado de Usuarios</div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-person-badge"></i>
                <h5>No hay usuarios registrados</h5>
                <p>Los usuarios que registres aparecerán aquí.</p>
                @if (!hasActiveElection)
                {
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Crear usuario</a>
                }
            </div>
        }
        else
        {
            <div class="data-table-wrap table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>@item.Email</td>
                                <td><code>@item.NombreUsuario</code></td>
                                <td><span class="badge bg-info">@item.Rol</span></td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (!hasActiveElection)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <form asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="@(item.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                              data-confirm-message="¿Está seguro que desea @(item.IsActive ? "desactivar" : "activar") al usuario @item.Nombre @item.Apellido?"
                                              data-confirm-consequence="@(item.IsActive ? "El usuario no podrá iniciar sesión mientras esté inactivo." : "El usuario podrá volver a iniciar sesión en el sistema.")"
                                              data-confirm-variant="@(item.IsActive ? "danger" : "success")"
                                              data-confirm-ok="@(item.IsActive ? "Desactivar" : "Activar")">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success")">
                                                <i class="bi bi-toggle-@(item.IsActive ? "off" : "on")"></i>
                                                @(item.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled><i class="bi bi-lock"></i> Bloqueado</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="data-card-list">
                @foreach (var item in Model)
                {
                    <div class="data-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong>@item.Nombre @item.Apellido</strong>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                @(item.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        <div class="data-card-row"><span class="label">Usuario</span><span class="value"><code>@item.NombreUsuario</code></span></div>
                        <div class="data-card-row"><span class="label">Email</span><span class="value">@item.Email</span></div>
                        <div class="data-card-row"><span class="label">Rol</span><span class="value"><span class="badge bg-info">@item.Rol</span></span></div>
                        @if (!hasActiveElection)
                        {
                            <div class="data-card-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                                <form asp-action="Toggle" asp-route-id="@item.Id" method="post"
                                      data-confirm="true"
                                      data-confirm-title="@(item.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                      data-confirm-message="¿Está seguro que desea @(item.IsActive ? "desactivar" : "activar") al usuario @item.Nombre @item.Apellido?"
                                      data-confirm-consequence="@(item.IsActive ? "El usuario no podrá iniciar sesión mientras esté inactivo." : "El usuario podrá volver a iniciar sesión en el sistema.")"
                                      data-confirm-variant="@(item.IsActive ? "danger" : "success")"
                                      data-confirm-ok="@(item.IsActive ? "Desactivar" : "Activar")">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success") w-100">
                                        <i class="bi bi-toggle-@(item.IsActive ? "off" : "on")"></i>
                                        @(item.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary w-100 mt-2" disabled><i class="bi bi-lock"></i> Bloqueado</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
