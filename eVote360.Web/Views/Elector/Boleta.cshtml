@model eVote360.Web.Models.ElectorViewModels.BoletaVM
@{
    ViewData["Title"] = $"Votar por {Model.NombrePuesto}";
}

<div class="container mt-4">
    <div class="page-header fade-in text-center">
        <h1><i class="bi bi-ballot-fill"></i> Votación - @Model.NombrePuesto</h1>
        <p class="lead">Seleccione su candidato preferido</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger slide-up">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1"><i class="bi bi-award"></i> Puesto: @Model.NombrePuesto</h5>
                    <p class="text-muted mb-0">@Model.Candidatos.Count candidatos compitiendo</p>
                </div>
                <div>
                    <span class="badge bg-primary">Seleccione 1 candidato</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="RegistrarVoto" method="post">
        <input type="hidden" asp-for="PuestoId" />
        <input type="hidden" asp-for="NumeroDocumento" />

        <div class="row g-4 mb-4">
            @foreach (var candidato in Model.Candidatos)
            {
                <div class="col-md-4 col-lg-3">
                    <label class="candidate-card" for="candidato_@candidato.CandidatoId">
                        <input type="radio" 
                               name="CandidatoSeleccionadoId" 
                               value="@candidato.CandidatoId" 
                               id="candidato_@candidato.CandidatoId"
                               class="d-none candidate-radio" />
                        
                        <div class="text-center">
                            <img src="@candidato.FotoCandidato" 
                                 alt="@candidato.NombreCandidato @candidato.ApellidoCandidato" 
                                 class="candidate-photo">
                            
                            <h5 class="mb-1">@candidato.NombreCandidato</h5>
                            <p class="text-muted mb-2">@candidato.ApellidoCandidato</p>
                            
                            <img src="@candidato.LogoPartido" 
                                 alt="@candidato.SiglasPartido" 
                                 class="party-logo">
                            <p class="fw-bold text-primary mb-0">@candidato.SiglasPartido</p>
                        </div>
                    </label>
                </div>
            }

            <!-- Opción "Ninguno" -->
            <div class="col-md-4 col-lg-3">
                <label class="candidate-card" for="candidato_ninguno">
                    <input type="radio" 
                           name="CandidatoSeleccionadoId" 
                           value="0" 
                           id="candidato_ninguno"
                           class="d-none candidate-radio" />
                    
                    <div class="text-center">
                        <div class="candidate-photo d-flex align-items-center justify-content-center bg-light">
                            <i class="bi bi-x-circle text-muted" style="font-size: 3rem;"></i>
                        </div>
                        
                        <h5 class="mb-1">Voto en Blanco</h5>
                        <p class="text-muted mb-2">Ninguno</p>
                        
                        <p class="fw-bold text-muted mb-0">Sin Partido</p>
                    </div>
                </label>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Opciones" asp-route-numeroDocumento="@Model.NumeroDocumento" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Puestos
                    </a>
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check-circle-fill"></i> Confirmar Voto
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    <script>
        document.querySelectorAll('.candidate-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                document.querySelectorAll('.candidate-card').forEach(card => {
                    card.classList.remove('selected');
                });
                if (this.checked) {
                    this.closest('.candidate-card').classList.add('selected');
                }
            });
        });
    </script>
}
