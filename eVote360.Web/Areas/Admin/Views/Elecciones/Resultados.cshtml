@model eVote360.Application.ViewModels.Elections.ResultadosEleccionVM
@{
    ViewData["Title"] = "Resultados de Elección";
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-bar-chart"></i> Resultados Electorales</h1>
            <p class="mb-0">@Model.EleccionNombre — @Model.FechaRealizacion.ToString("dd/MM/yyyy")</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>
</div>

<div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-people-fill me-2 fs-5"></i>
    <div><strong>Total de votantes:</strong> @Model.TotalVotos ciudadanos participaron en esta elección.</div>
</div>

@if (!Model.Puestos.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> No hay votos registrados para esta elección.
    </div>
}
else
{
    foreach (var puesto in Model.Puestos)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-briefcase"></i> @puesto.PuestoNombre</h5>
                <span class="badge bg-light text-primary">@puesto.TotalVotosPuesto votos</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Candidato</th>
                                <th>Partido</th>
                                <th>Votos</th>
                                <th style="min-width:160px;">Porcentaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rank = 1;}
                            @foreach (var candidato in puesto.Candidatos)
                            {
                                var badgeClass = rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary" : "bg-light text-muted";
                                var barColor = rank == 1 ? "bg-success" : rank == 2 ? "bg-primary" : "bg-secondary";
                                <tr>
                                    <td><span class="badge @badgeClass">@rank</span></td>
                                    <td><strong>@candidato.CandidatoNombre</strong></td>
                                    <td>
                                        @candidato.PartidoNombre
                                        @if (!string.IsNullOrEmpty(candidato.PartidoSiglas))
                                        {
                                            <span class="text-muted">(@candidato.PartidoSiglas)</span>
                                        }
                                    </td>
                                    <td><strong>@candidato.Votos</strong></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:18px;">
                                                <div class="progress-bar @barColor" style="width:@candidato.Porcentaje%">
                                                    @candidato.Porcentaje%
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<div class="text-center mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Regresar al Menú de Elecciones
    </a>
</div>
