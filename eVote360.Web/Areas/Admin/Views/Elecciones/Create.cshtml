@model eVote360.Application.ViewModels.Elections.ElectionFormVM
@{
    ViewData["Title"] = "Nueva Elección";
}

<div class="page-header">
    <h1><i class="bi bi-plus-circle"></i> Nueva Elección</h1>
</div>

@if (TempData["ValidationErrors"] != null)
{
    var errors = TempData["ValidationErrors"]!.ToString()!.Split('|');
    <div class="alert alert-warning">
        <h5><i class="bi bi-exclamation-triangle"></i> Requisitos no cumplidos</h5>
        <p class="mb-1">Para crear una elección deben cumplirse los siguientes requisitos:</p>
        <ul class="mb-0">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Información de la Elección
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Elecciones Generales 2026" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FechaRealizacion" class="form-label"></label>
                        <input asp-for="FechaRealizacion" class="form-control" type="date" />
                        <span asp-validation-for="FechaRealizacion" class="text-danger"></span>
                    </div>

                    <div class="alert alert-info mb-4">
                        <strong><i class="bi bi-shield-check"></i> Requisitos para crear una elección:</strong>
                        <ul class="mb-0 mt-2">
                            <li>No debe existir ninguna elección activa en el sistema.</li>
                            <li>Debe existir al menos un puesto electivo activo.</li>
                            <li>Deben existir al menos dos partidos políticos activos.</li>
                            <li>Cada partido activo debe tener candidatos para todos los puestos activos.</li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-play-circle"></i> Iniciar Elección
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
