@using eVote360.Application.DTOs.Response
@model List<CandidateResponseDto>
@{
    ViewData["Title"] = "Gestión de Candidatos";
    bool hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people-fill"></i> Candidatos</h1>
            <p class="mb-0">Vista general de todos los candidatos en el sistema</p>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Candidato</th>
                            <th>Partido</th>
                            <th>Puesto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(c.FotoPath) ? "/images/candidates/default.png" : c.FotoPath)"
                                         class="rounded-circle me-2" width="35" height="35" style="object-fit:cover;">
                                    @c.Nombre @c.Apellido
                                </td>
                                <td><span class="badge bg-secondary">@c.PartyNombre</span></td>
                                <td>@(c.PositionNombre ?? "Sin asignar")</td>
                                <td>
                                    @if (c.IsActive)
                                    { <span class="badge bg-success">Activo</span> }
                                    else
                                    { <span class="badge bg-danger">Inactivo</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No hay candidatos registrados.
            </div>
        }
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
