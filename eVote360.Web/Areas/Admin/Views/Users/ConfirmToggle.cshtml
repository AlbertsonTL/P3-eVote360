@{
    ViewData["Title"] = ViewBag.Activate ? "Activar Usuario" : "Desactivar Usuario";
    int userId = ViewBag.UserId;
    string userNombre = ViewBag.UserNombre ?? "";
    bool activate = ViewBag.Activate;
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card border-warning slide-up">
            <div class="card-header @(activate ? "bg-success text-white" : "bg-warning text-dark")">
                <i class="bi bi-exclamation-triangle-fill"></i> Confirmación
            </div>
            <div class="card-body p-4 text-center">
                <i class="bi bi-person-@(activate ? "check" : "x") text-@(activate ? "success" : "warning")" style="font-size:3rem;"></i>
                <h4 class="mt-3">¿Está seguro que desea @(activate ? "activar" : "desactivar") este usuario?</h4>
                <p class="text-muted"><strong>@userNombre</strong></p>
                <div class="d-flex gap-3 justify-content-center mt-4">
                    <form asp-action="Toggle" asp-route-id="@userId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(activate ? "btn-success" : "btn-warning") btn-lg">
                            <i class="bi bi-check-circle"></i> Aceptar
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
