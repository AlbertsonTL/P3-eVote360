@model List<eVote360.Application.ViewModels.Citizens.CitizenVM>
@{
    ViewData["Title"] = "Gestión de Ciudadanos";
    var hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-people"></i> Gestión de Ciudadanos</h1>
            <p class="mb-0">Administre el padrón electoral</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Nuevo Ciudadano
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled title="No se pueden crear ciudadanos durante una elección activa">
                    <i class="bi bi-lock-fill"></i> Crear (Bloqueado)
                </button>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (hasActiveElection)
{
    <div class="election-lock-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div><strong>Elección activa:</strong> los datos del padrón están bloqueados mientras la elección se encuentra en proceso.</div>
    </div>
}

<div class="card">
    <div class="card-header">
        <i class="bi bi-list-ul"></i> Listado de Ciudadanos (@Model.Count)
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <h5>No hay ciudadanos registrados</h5>
                <p>Los ciudadanos que registres aparecerán aquí.</p>
                @if (!hasActiveElection)
                {
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear ciudadano</a>
                }
            </div>
        }
        else
        {
            <!-- Tabla clásica: solo en tablet/desktop (>= 768px) -->
            <div class="data-table-wrap table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Cédula</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var citizen in Model)
                        {
                            <tr>
                                <td>@citizen.Nombre</td>
                                <td>@citizen.Apellido</td>
                                <td>@citizen.Email</td>
                                <td>@citizen.NumeroDocumento</td>
                                <td>
                                    <span class="badge @(citizen.IsActive ? "bg-success" : "bg-danger")">
                                        @(citizen.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (!hasActiveElection)
                                    {
                                        <a asp-action="Edit" asp-route-id="@citizen.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <form asp-action="Toggle" asp-route-id="@citizen.Id" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="@(citizen.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                              data-confirm-message="¿Está seguro que desea @(citizen.IsActive ? "desactivar" : "activar") a @citizen.Nombre @citizen.Apellido?"
                                              data-confirm-consequence="@(citizen.IsActive ? "Esta acción impedirá que el ciudadano participe en el proceso de votación." : "El ciudadano volverá a poder participar en el proceso de votación.")"
                                              data-confirm-variant="@(citizen.IsActive ? "danger" : "success")"
                                              data-confirm-ok="@(citizen.IsActive ? "Desactivar" : "Activar")">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(citizen.IsActive ? "btn-danger" : "btn-success")">
                                                <i class="bi bi-toggle-@(citizen.IsActive ? "off" : "on")"></i>
                                                @(citizen.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled><i class="bi bi-lock"></i> Bloqueado</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Cards apiladas: solo en móvil (< 768px) -->
            <div class="data-card-list">
                @foreach (var citizen in Model)
                {
                    <div class="data-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong>@citizen.Nombre @citizen.Apellido</strong>
                            <span class="badge @(citizen.IsActive ? "bg-success" : "bg-danger")">
                                @(citizen.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        <div class="data-card-row"><span class="label">Email</span><span class="value">@citizen.Email</span></div>
                        <div class="data-card-row"><span class="label">Cédula</span><span class="value">@citizen.NumeroDocumento</span></div>
                        @if (!hasActiveElection)
                        {
                            <div class="data-card-actions">
                                <a asp-action="Edit" asp-route-id="@citizen.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                                <form asp-action="Toggle" asp-route-id="@citizen.Id" method="post"
                                      data-confirm="true"
                                      data-confirm-title="@(citizen.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                      data-confirm-message="¿Está seguro que desea @(citizen.IsActive ? "desactivar" : "activar") a @citizen.Nombre @citizen.Apellido?"
                                      data-confirm-consequence="@(citizen.IsActive ? "Esta acción impedirá que el ciudadano participe en el proceso de votación." : "El ciudadano volverá a poder participar en el proceso de votación.")"
                                      data-confirm-variant="@(citizen.IsActive ? "danger" : "success")"
                                      data-confirm-ok="@(citizen.IsActive ? "Desactivar" : "Activar")">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(citizen.IsActive ? "btn-danger" : "btn-success") w-100">
                                        <i class="bi bi-toggle-@(citizen.IsActive ? "off" : "on")"></i>
                                        @(citizen.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary w-100 mt-2" disabled><i class="bi bi-lock"></i> Bloqueado</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
