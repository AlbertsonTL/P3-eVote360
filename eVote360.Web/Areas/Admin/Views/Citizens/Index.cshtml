@model List<eVote360.Application.ViewModels.Citizens.CitizenVM>
@{
    ViewData["Title"] = "Gestión de Ciudadanos";
    var hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people"></i> Gestión de Ciudadanos</h1>
            <p class="mb-0">Administre el padrón electoral</p>
        </div>
        <div>
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Nuevo Ciudadano
                </a>
            }
        </div>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-house"></i> Menú Principal
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <i class="bi bi-list-ul"></i> Listado de Ciudadanos (@Model.Count)
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Email</th>
                        <th>Cédula</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var citizen in Model)
                    {
                        <tr>
                            <td>@citizen.Nombre</td>
                            <td>@citizen.Apellido</td>
                            <td>@citizen.Email</td>
                            <td>@citizen.NumeroDocumento</td>
                            <td>
                                @if (citizen.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>
                                @if (!hasActiveElection)
                                {
                                    <a asp-action="Edit" asp-route-id="@citizen.Id" class="btn btn-sm btn-warning">Editar</a>
                                    <a asp-action="Toggle" asp-route-id="@citizen.Id" class="btn btn-sm @(citizen.IsActive ? "btn-danger" : "btn-success")">
                                        @(citizen.IsActive ? "Desactivar" : "Activar")
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
