@model List<eVote360.Application.ViewModels.Elections.ElectionListVM>
@{
    ViewData["Title"] = "Gestión de Elecciones";
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-card-checklist"></i> Gestión de Elecciones</h1>
            <p class="mb-0">Administre los procesos electorales del sistema</p>
        </div>
        <div class="d-flex gap-2">
            @if (!Model.Any(e => e.EsActiva))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill"></i> Nueva Elección
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon primary"><i class="bi bi-card-checklist"></i></div>
            <div class="stat-card-title">Total Elecciones</div>
            <div class="stat-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon success"><i class="bi bi-circle-fill"></i></div>
            <div class="stat-card-title">En Proceso</div>
            <div class="stat-card-value">@Model.Count(e => e.EsActiva)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon warning"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-card-title">Finalizadas</div>
            <div class="stat-card-value">@Model.Count(e => !e.EsActiva)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-list-ul"></i> Listado de Elecciones
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-card-checklist"></i>
                <h5>No hay elecciones registradas</h5>
                <p>Crea la primera elección para comenzar el proceso electoral.</p>
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Crear primera elección</a>
            </div>
        }
        else
        {
            <div class="data-table-wrap table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Fecha de Realización</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var election in Model)
                        {
                            <tr class="@(election.EsActiva ? "table-success" : "")">
                                <td>@election.Id</td>
                                <td>
                                    <strong>@election.Nombre</strong>
                                    @if (election.EsActiva)
                                    {
                                        <span class="badge bg-success ms-2">ACTIVA</span>
                                    }
                                </td>
                                <td>@election.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (election.EsActiva)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-circle-fill"></i> En Proceso</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-check-circle-fill"></i> Finalizada</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (!election.EsActiva)
                                        {
                                            <a asp-action="Resultados" asp-route-id="@election.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-bar-chart"></i> Ver Resultados
                                            </a>
                                        }
                                        @if (election.EsActiva)
                                        {
                                            <form asp-action="Finalize" asp-route-id="@election.Id" method="post" class="d-inline"
                                                  data-confirm="true"
                                                  data-confirm-title="Confirmar finalización"
                                                  data-confirm-message="¿Está seguro que desea finalizar la elección «@election.Nombre»?"
                                                  data-confirm-consequence="Esta acción cambiará el estado a Finalizada y no podrá revertirse."
                                                  data-confirm-variant="danger"
                                                  data-confirm-ok="Finalizar">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-stop-circle"></i> Finalizar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="data-card-list">
                @foreach (var election in Model)
                {
                    <div class="data-card @(election.EsActiva ? "border-start border-4 border-success" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong>@election.Nombre</strong>
                            @if (election.EsActiva)
                            {
                                <span class="badge bg-success"><i class="bi bi-circle-fill"></i> En Proceso</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-check-circle-fill"></i> Finalizada</span>
                            }
                        </div>
                        <div class="data-card-row"><span class="label">Fecha</span><span class="value">@election.FechaRealizacion.ToString("dd/MM/yyyy")</span></div>
                        <div class="data-card-actions">
                            @if (!election.EsActiva)
                            {
                                <a asp-action="Resultados" asp-route-id="@election.Id" class="btn btn-sm btn-info"><i class="bi bi-bar-chart"></i> Resultados</a>
                            }
                            @if (election.EsActiva)
                            {
                                <form asp-action="Finalize" asp-route-id="@election.Id" method="post"
                                      data-confirm="true"
                                      data-confirm-title="Confirmar finalización"
                                      data-confirm-message="¿Está seguro que desea finalizar la elección «@election.Nombre»?"
                                      data-confirm-consequence="Esta acción cambiará el estado a Finalizada y no podrá revertirse."
                                      data-confirm-variant="danger"
                                      data-confirm-ok="Finalizar">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger w-100"><i class="bi bi-stop-circle"></i> Finalizar</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
