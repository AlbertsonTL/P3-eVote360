@model eVote360.Application.ViewModels.Position.PositionFormVM
@{
    ViewData["Title"] = "Editar Puesto Electivo";
}

<div class="page-header fade-in">
    <h1><i class="bi bi-pencil-square"></i> Editar Puesto Electivo</h1>
    <p>Modifique la información del puesto</p>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card slide-up">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label">
                            <i class="bi bi-award-fill"></i> Nombre del Puesto
                        </label>
                        <input asp-for="Nombre" class="form-control form-control-lg" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label">
                            <i class="bi bi-card-text"></i> Descripción
                        </label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4" required></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save-fill"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle-fill"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
