@{
    ViewData["Title"] = "Sistema de Votación Electrónica";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto text-center fade-in">
            <div class="mb-5">
                <h1 class="display-3 fw-bold text-primary mb-3">
                    <i class="bi bi-shield-check"></i> eVote360
                </h1>
                <p class="lead text-muted">Sistema Seguro de Votación Electrónica de República Dominicana</p>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stat-card text-center">
                        <div class="stat-card-icon primary mx-auto">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h5>Seguro</h5>
                        <p class="text-muted mb-0">Verificación biométrica y OCR</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card text-center">
                        <div class="stat-card-icon success mx-auto">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <h5>Confiable</h5>
                        <p class="text-muted mb-0">Transparencia total</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card text-center">
                        <div class="stat-card-icon warning mx-auto">
                            <i class="bi bi-lightning"></i>
                        </div>
                        <h5>Rápido</h5>
                        <p class="text-muted mb-0">Resultados instantáneos</p>
                    </div>
                </div>
            </div>

            <div class="card voting-card slide-up">
                <div class="card-body p-5">
                    <h2 class="mb-4">
                        <i class="bi bi-person-check"></i> Iniciar Proceso de Votación
                    </h2>
                    <p class="text-muted mb-4">Ingrese su número de cédula para comenzar</p>
                    
                    <form asp-controller="Elector" asp-action="ValidarElector" method="post">
                        <div class="row">
                            <div class="col-md-8 mx-auto">
                                <div class="input-group input-group-lg mb-3">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="bi bi-credit-card-2-front"></i>
                                    </span>
                                    <input type="text" 
                                           class="form-control" 
                                           id="numeroDocumento" 
                                           name="numeroDocumento" 
                                           placeholder="Ej: 001-1234567-1"
                                           pattern="\d{3}-\d{7}-\d{1}"
                                           required>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-arrow-right-circle"></i> Votar Ahora
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4">
                <p class="text-muted">
                    <i class="bi bi-info-circle"></i> 
                    ¿Problemas para votar? <a href="#" class="text-primary">Contáctenos</a>
                </p>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
