@using eVote360.Domain.Entities
@model List<Candidatura>
@{ ViewData["Title"] = "Candidatos Asignados a Puestos"; bool hasActiveElection = (bool)ViewBag.HasActiveElection; }
<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1><i class="bi bi-award"></i> Candidatos Asignados a Puestos</h1>
        <div class="d-flex gap-2">
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Asignación</a>
            }
        </div>
    </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@if (hasActiveElection)
{
    <div class="election-lock-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div><strong>Elección activa:</strong> no se pueden crear ni quitar asignaciones mientras haya una elección en proceso.</div>
    </div>
}

<div class="card slide-up">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-award"></i>
                <h5>No hay candidatos asignados a puestos</h5>
                <p>Las asignaciones que crees aparecerán aquí.</p>
                @if (!hasActiveElection)
                {
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva asignación</a>
                }
            </div>
        }
        else
        {
            <div class="data-table-wrap table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark"><tr><th>Candidato</th><th>Partido Origen</th><th>Puesto</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td><strong>@c.Candidate?.Nombre @c.Candidate?.Apellido</strong></td>
                                <td><span class="badge bg-info">@c.Candidate?.Party?.Siglas</span></td>
                                <td>@c.Position?.Nombre</td>
                                <td class="text-end">
                                    @if (!hasActiveElection)
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="Quitar asignación"
                                              data-confirm-message="¿Desea quitar la asignación de @c.Candidate?.Nombre @c.Candidate?.Apellido del puesto @c.Position?.Nombre?"
                                              data-confirm-consequence="El candidato dejará de estar postulado para este puesto."
                                              data-confirm-variant="danger"
                                              data-confirm-ok="Quitar">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Quitar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="data-card-list">
                @foreach (var c in Model)
                {
                    <div class="data-card">
                        <div class="mb-2"><strong>@c.Candidate?.Nombre @c.Candidate?.Apellido</strong></div>
                        <div class="data-card-row"><span class="label">Partido</span><span class="value"><span class="badge bg-info">@c.Candidate?.Party?.Siglas</span></span></div>
                        <div class="data-card-row"><span class="label">Puesto</span><span class="value">@c.Position?.Nombre</span></div>
                        @if (!hasActiveElection)
                        {
                            <div class="data-card-actions">
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                      data-confirm="true"
                                      data-confirm-title="Quitar asignación"
                                      data-confirm-message="¿Desea quitar la asignación de @c.Candidate?.Nombre @c.Candidate?.Apellido del puesto @c.Position?.Nombre?"
                                      data-confirm-consequence="El candidato dejará de estar postulado para este puesto."
                                      data-confirm-variant="danger"
                                      data-confirm-ok="Quitar">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Quitar</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
