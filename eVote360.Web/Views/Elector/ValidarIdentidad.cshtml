@model eVote360.Web.Models.ElectorViewModels.ValidarIdentidadVM
@{
    ViewData["Title"] = "Validar Identidad";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card voting-card fade-in">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="stat-card-icon primary mx-auto mb-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-shield-check" style="font-size: 3rem;"></i>
                        </div>
                        <h2><i class="bi bi-person-badge"></i> Validación de Identidad</h2>
                        <p class="text-muted">Por favor, cargue una foto clara de su cédula de identidad</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger slide-up">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                        </div>
                    }

                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Instrucciones:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Asegúrese de que la foto muestre solo el frente de la cédula</li>
                            <li>La imagen debe estar bien iluminada</li>
                            <li>Evite reflejos y sombras</li>
                            <li>La cédula debe estar completamente visible</li>
                        </ul>
                    </div>

                    <form asp-action="ValidarIdentidad" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="NumeroDocumento" />
                        
                        <div class="mb-4">
                            <label asp-for="FotoCedula" class="form-label">
                                <i class="bi bi-camera-fill"></i> Foto de la Cédula
                            </label>
                            <input asp-for="FotoCedula" 
                                   class="form-control form-control-lg" 
                                   type="file" 
                                   accept="image/*"
                                   required
                                   onchange="previewImage(event)" />
                            <span asp-validation-for="FotoCedula" class="text-danger"></span>
                        </div>

                        <div id="imagePreview" class="text-center mb-4" style="display: none;">
                            <img id="preview" src="#" alt="Vista previa" style="max-width: 100%; max-height: 300px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="bi bi-check-circle-fill"></i> Validar Identidad
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted">
                    <i class="bi bi-lock-fill"></i> Sus datos están protegidos y se utilizan únicamente para verificación electoral
                </p>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const preview = document.getElementById('preview');
            const previewContainer = document.getElementById('imagePreview');
            const file = event.target.files[0];
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}
