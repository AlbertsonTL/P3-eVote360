@{
    ViewData["Title"] = "Mensaje";
    var mensaje = ViewBag.Message as string ?? "Información";
    var tipo = ViewBag.TipoMensaje as string ?? "info";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card text-center shadow">
                <div class="card-body p-4 p-md-5">
                    @if (tipo == "success")
                    {
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                        <h2 class="text-success mt-3">¡Listo!</h2>
                    }
                    else if (tipo == "error")
                    {
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                        <h2 class="text-danger mt-3">Error</h2>
                    }
                    else
                    {
                        <i class="bi bi-info-circle-fill text-warning" style="font-size: 4rem;"></i>
                        <h2 class="text-warning mt-3">Información</h2>
                    }

                    <p class="lead mt-3">@mensaje</p>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door-fill"></i> Volver al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

