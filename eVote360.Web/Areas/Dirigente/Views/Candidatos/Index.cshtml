@using eVote360.Application.DTOs.Response
@model List<CandidateResponseDto>
@{
    ViewData["Title"] = "Mis Candidatos";
    bool hasActiveElection = ViewBag.HasActiveElection ?? false;
}

<div class="page-header fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1><i class="bi bi-people-fill"></i> Mis Candidatos</h1>
            <p class="mb-0">Candidatos registrados en su partido político</p>
        </div>
        <div class="d-flex gap-2">
            @if (!hasActiveElection)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill"></i> Nuevo Candidato
                </a>
                <a asp-action="Asignar" class="btn btn-warning">
                    <i class="bi bi-award"></i> Asignar a Puesto
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon primary"><i class="bi bi-people"></i></div>
            <div class="stat-card-title">Total</div>
            <div class="stat-card-value">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon success"><i class="bi bi-check-circle"></i></div>
            <div class="stat-card-title">Activos</div>
            <div class="stat-card-value">@Model.Count(c => c.IsActive)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-icon warning"><i class="bi bi-award"></i></div>
            <div class="stat-card-title">Con Puesto Asignado</div>
            <div class="stat-card-value">@Model.Count(c => c.PositionId.HasValue)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-list-ul"></i> Listado de Candidatos</div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Foto</th>
                            <th>Nombre Completo</th>
                            <th>Puesto Asignado</th>
                            <th>Estado</th>
                            @if (!hasActiveElection) { <th>Acciones</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(c.FotoPath) ? "/images/candidates/default.png" : c.FotoPath)"
                                         class="rounded-circle" width="40" height="40" style="object-fit:cover;">
                                </td>
                                <td><strong>@c.Nombre @c.Apellido</strong></td>
                                <td>
                                    @if (c.PositionId.HasValue)
                                    {
                                        <span class="badge bg-info">@c.PositionNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">Sin asignar</span>
                                    }
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    { <span class="badge bg-success">Activo</span> }
                                    else
                                    { <span class="badge bg-danger">Inactivo</span> }
                                </td>
                                @if (!hasActiveElection)
                                {
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Toggle" asp-route-id="@c.Id" method="post" class="d-inline"
                                                  data-confirm="true"
                                                  data-confirm-title="@(c.IsActive ? "Confirmar desactivación" : "Confirmar activación")"
                                                  data-confirm-message="¿Está seguro que desea @(c.IsActive ? "desactivar" : "activar") al candidato @c.Nombre @c.Apellido?"
                                                  data-confirm-consequence="@(c.IsActive ? "El candidato dejará de estar disponible para asignaciones y votación." : "El candidato volverá a estar disponible para asignaciones y votación.")"
                                                  data-confirm-variant="@(c.IsActive ? "danger" : "success")"
                                                  data-confirm-ok="@(c.IsActive ? "Desactivar" : "Activar")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-danger" : "btn-success")" aria-label="@(c.IsActive ? "Desactivar" : "Activar") candidato" title="@(c.IsActive ? "Desactivar" : "Activar")">
                                                    <i class="bi bi-@(c.IsActive ? "x-circle" : "check-circle")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No hay candidatos registrados. 
                @if (!hasActiveElection) { <a asp-action="Create" class="alert-link">Agregar primer candidato</a> }
            </div>
        }
    </div>
</div>

